rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Each authenticated account stores its own schedule entries in:
    //   users/{Firebase Auth UID}/entries/{entry ID}
    //
    // Entry fields (all required):
    //   title: string, 1-100 characters
    //   date: string, YYYY-MM-DD format (calendar validity is enforced by
    //         the date input in the client; rules validate its shape)
    //   time: string, empty or 24-hour HH:mm, at most 5 characters
    //   note: string, at most 2,000 characters; may be empty
    //   done: boolean
    //   createdAt: timestamp, immutable after creation
    //   updatedAt: timestamp, set to request.time on writes
    //
    // No UID is stored in an entry document; ownership is derived from the
    // path and compared with the signed-in Firebase Auth UID.
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isNonAnonymousUser() {
      return isAuthenticated()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // The entry schema does not define a UID field. These guards also prevent
    // ownership data from being added or changed if the model evolves later.
    function uidUnchanged() {
      return !('uid' in request.resource.data)
        || (isAuthenticated() && request.resource.data.uid == request.auth.uid);
    }

    function uidNotModified() {
      return !('uid' in request.resource.data)
        || (resource.data.keys().hasAny(['uid'])
          && request.resource.data.uid == resource.data.uid);
    }

    function isValidEntry(data) {
      return data.keys().hasAll([
          'title', 'date', 'time', 'note', 'done', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'date', 'time', 'note', 'done', 'createdAt', 'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.time is string
        && data.time.size() <= 5
        && (data.time == '' || data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && data.note is string
        && data.note.size() <= 2000
        && data.done is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/entries/{entryId} {
      // Only a non-anonymous owner can read or mutate their schedule entries.
      allow read: if isOwner(userId) && isNonAnonymousUser();

      // Server timestamps resolve to request.time in security rules.
      allow create: if isOwner(userId)
        && isNonAnonymousUser()
        && uidUnchanged()
        && isValidEntry(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Validate the complete document again on every update and keep the
      // original creation timestamp immutable.
      allow update: if isOwner(userId)
        && isNonAnonymousUser()
        && uidNotModified()
        && isValidEntry(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(userId) && isNonAnonymousUser();
    }

    // Default deny for every other document path.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
